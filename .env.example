# Puerto del servidor (la API y, en producción, la web).
PORT=3001

# Dónde se guardan la base de datos SQLite y las fotos subidas.
DB_FILE=./data/sparka.db
UPLOAD_DIR=./data/uploads

# Perfiles de ejemplo marcados como "Demo". Pon false cuando haya gente real.
DEMO_MODE=true

# true si va detrás de un proxy HTTPS (Render, Fly.io, Nginx…): activa cookies seguras.
TRUST_PROXY=false
